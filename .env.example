# Google Gemini API Key
# รับ API Key ได้ที่: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Key สำรอง (ไม่บังคับ): สร้างจาก Google project อื่น แต่ละ project มีโควตาฟรีรายวันของตัวเอง
# เมื่อโควตาของ key แรกหมด เซิร์ฟเวอร์จะสลับมาใช้ key ถัดไปเอง (ใส่ได้ถึง GEMINI_API_KEY_9)
GEMINI_API_KEY_2=

# Supabase (ระบบเข้าสู่ระบบ + เก็บข้อมูลบนบัญชี) — ดูวิธีตั้งค่าใน README
# เว้นว่างไว้ = ไม่มีหน้าล็อกอิน เก็บข้อมูลในเบราว์เซอร์อย่างเดียว (ใช้ได้เฉพาะตอนรันบนเครื่อง)
# Supabase → Project Settings → API: Project URL และ anon / publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
